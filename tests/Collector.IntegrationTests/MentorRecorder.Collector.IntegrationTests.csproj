<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>MentorRecorder.Collector.IntegrationTests</AssemblyName>
    <RootNamespace>MentorRecorder.Collector.IntegrationTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />

    <!--
      Draft 2020-12 validator. The contract tests validate every response and
      every live event the Collector writes against contracts/ipc-v1.schema.json,
      so an undeclared field fails the build instead of reaching a client.
    -->
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Collector\MentorRecorder.Collector.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Match shipping HSSF-only assets; project-reference transitivity otherwise restores image runtime DLLs. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="[2.1.11]" ExcludeAssets="runtime" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with the unit tests: keeps every run out of the real data folder. -->
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The fixtures are the executable form of docs/state-machine.md; the integration suite
      replays every one of them, so they travel with the test binaries.
    -->
    <None Include="..\Fixtures\**\*" Link="Fixtures\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
