{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mentor-recorder.invalid/protocol-profiles/profile.schema.json",
  "title": "MentorRecorder protocol profile",
  "description": "Structure of one protocol profile. Carrying an opcode or an offset here is a claim about the real game protocol and requires the evidence described in docs/protocol-profile-format.md. UNSUPPORTED profiles carry no message definitions at all.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "region",
    "game_build",
    "generated_at",
    "mentor_roulette_id",
    "compatibility_status",
    "messages",
    "fixtures",
    "provenance",
    "profile_sha256"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1, "maximum": 1 },
    "profile_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$" },
    "region": { "enum": ["CN", "GLOBAL", "UNKNOWN"] },
    "game_build": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$" },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$"
    },
    "mentor_roulette_id": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
    "compatibility_status": { "enum": ["VERIFIED", "CANDIDATE", "UNSUPPORTED", "SYNTHETIC"] },
    "match_window_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
    "messages": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/message" } },
    "hypotheses": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/hypothesis" },
      "description": "Opcode-only observations, permitted only for CANDIDATE profiles. Names and (direction, opcode) pairs must be unique. A nonempty hypotheses-only profile has empty messages and null mentor_roulette_id. Never drives formal parsing or recording."
    },
    "obfuscated_opcodes": {
      "type": "array",
      "maxItems": 256,
      "items": { "type": "integer", "minimum": 0, "maximum": 65535 },
      "description": "Opcodes this client build is known to scramble. Written from an offline extraction against the user's own executable, or from the user's own verification on their own machine -- never copied from a third party. The parser refuses any message whose opcode appears here, so a profile that also declares such an opcode as a message is refused at load time. This project never descrambles; the list exists so the assumption 'the four packets we need are not obfuscated' is data that can be checked rather than a comment. See docs/protocol-profile-format.md section 8."
    },
    "calibration": { "$ref": "#/$defs/calibration" },
    "fixtures": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/fixture" } },
    "provenance": { "$ref": "#/$defs/provenance" },
    "profile_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finder_request", "finder_reply_max_ms"],
      "description": "Shape knowledge for re-learning opcodes on a client build with no profile. Permitted only on VERIFIED and SYNTHETIC profiles, which act as templates; a VERIFIED template needs a non-SYNTHETIC evidence entry for calibration.finder_request. Never drives formal parsing or recording: the observer it configures only proposes a draft that the user confirms and that is then written and re-loaded as an ordinary profile.",
      "properties": {
        "finder_request": { "$ref": "#/$defs/calibration_finder_request" },
        "finder_reply_max_ms": { "type": "integer", "minimum": 1, "maximum": 60000 }
      }
    },
    "calibration_finder_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "expected_length", "roulette_field"],
      "description": "The duty-finder action the client sends when the player picks a roulette. Its roulette id must be echoed by CONTENT_FINDER_POP within finder_reply_max_ms; that echo is what identifies both opcodes on a new build. roulette_field is an ordinary field definition whose name must be roulette_id.",
      "properties": {
        "direction": { "enum": ["SERVER_TO_CLIENT", "CLIENT_TO_SERVER"] },
        "expected_length": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "roulette_field": { "$ref": "#/$defs/field" }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "direction", "opcode", "note"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
        "direction": { "enum": ["SERVER_TO_CLIENT", "CLIENT_TO_SERVER"] },
        "opcode": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "expected_length": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "min_length": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "max_length": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "note": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "group": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 64, "description": "Human-readable display name for the desktop UI (typically Chinese). Optional; the UI falls back to `name`. Purely cosmetic: it never influences matching, eligibility or evidence." }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "opcode", "direction", "fields"],
      "properties": {
        "name": {
          "enum": [
            "CONTENT_FINDER_POP",
            "ZONE_INITIALIZATION",
            "ZONE_TERRITORY",
            "DUTY_RESULT",
            "PLAYER_JOB",
            "ZONE_LEFT",
            "INSTANCE_LEFT",
            "MATCH_CANCELLED",
            "MATCH_ANNOUNCED"
          ]
        },
        "opcode": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "direction": { "enum": ["SERVER_TO_CLIENT", "CLIENT_TO_SERVER"] },
        "segment_type": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "expected_length": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "min_length": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "max_length": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "victory_values": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
        },
        "fields": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/field" } }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "offset", "type"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "offset": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "type": { "enum": ["u8", "u16", "u32", "i32", "u64", "bytes"] },
        "length": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "endian": { "enum": ["little", "big"] },
        "role": { "enum": ["value", "selector"] },
        "constraints": { "$ref": "#/$defs/constraints" }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": { "type": "integer" },
        "max": { "type": "integer" },
        "in": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "integer" } }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "evidence"],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "capture_fixture": { "type": ["string", "null"], "maxLength": 512 },
        "capture_fixture_sha256": { "type": ["string", "null"] },
        "evidence": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "method", "recorded_at_utc", "note"],
      "properties": {
        "field": { "type": "string", "minLength": 1, "maxLength": 256 },
        "method": {
          "enum": ["OBSERVED_LOCAL_TRAFFIC", "PUBLIC_DOCUMENTATION", "USER_CONFIRMED", "SYNTHETIC"]
        },
        "recorded_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$"
        },
        "sample_count": { "type": ["integer", "null"], "minimum": 0 },
        "t_ms": { "type": "integer", "minimum": 0, "description": "User-confirmed elapsed milliseconds in the referenced local trace; not a parsed protocol field." },
        "url": { "type": ["string", "null"], "maxLength": 512 },
        "note": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    }
  }
}
