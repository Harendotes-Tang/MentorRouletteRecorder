<Project>

  <!--
    Shared MSBuild properties for every C# project in this repository.
    Rationale for each setting is documented in docs/build-and-package.md.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>7</WarningLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <!-- Chinese (Simplified) is the default UI language; culture data must be available. -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Deterministic, reproducible output. -->
    <Deterministic>true</Deterministic>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      Debug information must not carry the maintainer's absolute source paths. Symbols are
      kept, because file and line numbers are what make a crash report actionable, so the
      paths are removed instead:

        PathMap   rewrites the repository root to /_/ in every source path the compiler
                  records - in the PDB and in the pdb path stamped into the PE.
        embedded  puts the (now path-free) PDB inside the assembly, so there is no separate
                  .pdb file to leak, to forget, or to ship out of sync with its binary.

      scripts/package.ps1 -Verify scans the whole artifact for the repository root as ASCII
      and as UTF-16 and fails if it finds it; Assert-NoForbiddenPayload rejects loose *.pdb.

      Release only: a Debug build keeps its side-by-side pdb with real paths so an IDE can
      still find the sources on the machine that built it.
    -->
    <PathMap Condition="'$(Configuration)' == 'Release'">$(MSBuildThisFileDirectory)=/_/</PathMap>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>

    <!-- Project-wide identity. -->
    <Company>MentorRecorder</Company>
    <Product>FF14 导随记录器 / FF14 Mentor Roulette Recorder</Product>
    <!--
      ================= THE ONLY TWO LINES A HUMAN EDITS TO CHANGE THE VERSION =================

      VersionPrefix is the release number, always three plain numbers.
      VersionSuffix is empty for a release and `beta.N` for a test build, which makes the
      version `X.Y.Z-beta.N`. A test build handed to users must always carry a suffix, so a
      release number is never spent on something that was not released; the release is then
      cut by emptying VersionSuffix again. See docs/release-checklist.md.

        release      VersionPrefix = 1.4.0   VersionSuffix = (empty)   ->  1.4.0
        test build   VersionPrefix = 1.4.0   VersionSuffix = beta.1    ->  1.4.0-beta.1

      Everything else derives from these two: Version/InformationalVersion carry the full
      string (suffix included) and are what the user sees, while AssemblyVersion and
      FileVersion stay purely numeric - a Windows version resource has four numeric fields
      and cannot hold a suffix at all. scripts/package.ps1 and the root CMakeLists.txt read
      these two properties out of this file; no second literal exists anywhere.

      Do not write the two element names in angle brackets anywhere in a comment in this
      file. The root CMakeLists.txt and the Desktop version test read them with a line
      regex, not an XML parser, and take the first line that matches - a commented-out
      example would quietly become the version the Desktop is built with.
      ==========================================================================================
    -->
    <VersionPrefix>1.5.0</VersionPrefix>
    <VersionSuffix>beta.1</VersionSuffix>
    <Version Condition="'$(VersionSuffix)' == ''">$(VersionPrefix)</Version>
    <Version Condition="'$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <NeutralLanguage>zh-Hans</NeutralLanguage>

    <!-- Licensing: the project is GPL-3.0-or-later (see LICENSE / THIRD_PARTY_NOTICES.md). -->
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>

    <!--
      MSB3246 is emitted because the Machina.FFXIV package places a native
      (non-managed) DLL in lib/netstandard2.0/. It is not a reference assembly
      and Directory.Build.targets strips it from the output, so the warning is
      downgraded to a message instead of failing the build.
    -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3246</MSBuildWarningsAsMessages>
  </PropertyGroup>

</Project>
